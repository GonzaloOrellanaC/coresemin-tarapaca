{
  "name": "coresemin-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "cd app && npm install",
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "pm2:start:ts": "pm2 start index.js --name coresemin-server",
    "create-zip": "node scripts/create-zip.js",
    "deploy": "bash deploy.sh",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "dependencies": {
    "app": "^0.1.0",
    "archiver": "^5.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "fast-glob": "^3.2.12",
    "helmet": "^6.0.1",
    "ignore": "^5.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.7.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "pm2": "^5.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}